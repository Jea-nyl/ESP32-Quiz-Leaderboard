<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Quiz Leaderboard</title>
<style>
  body { font-family: Arial; background: #f0f0f0; text-align: center; padding: 50px;}
  table { margin: auto; border-collapse: collapse; width: 60%; }
  th, td { border: 1px solid #333; padding: 10px; }
  th { background: #333; color: #fff; }
</style>
</head>
<body>
<h1>Quiz Leaderboard</h1>
<table id="leaderboard">
  <thead>
    <tr>
      <th>Rank</th>
      <th>Score</th>
      <th>Timestamp</th>
    </tr>
  </thead>
  <tbody>
  </tbody>
</table>

<script>
const FIREBASE_URL = "https://yourproject.firebaseio.com/scores.json";

async function loadLeaderboard() {
  const response = await fetch(FIREBASE_URL);
  const data = await response.json();
  const scores = [];

  for(const key in data){
    scores.push({score: data[key].score, timestamp: data[key].timestamp});
  }

  // Sort descending
  scores.sort((a,b) => b.score - a.score);

  const tbody = document.querySelector("#leaderboard tbody");
  tbody.innerHTML = "";
  scores.forEach((entry, idx) => {
    const date = new Date(entry.timestamp);
    const tr = document.createElement("tr");
    tr.innerHTML = `<td>${idx+1}</td><td>${entry.score}</td><td>${date.toLocaleString()}</td>`;
    tbody.appendChild(tr);
  });
}

loadLeaderboard();
</script>
</body>
</html>
